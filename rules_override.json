  "rules": [
    {
      "id": "open_ad_skip_global",
      "name": "开屏广告-全局文本兜底（高召回）",
      "enabled": true,
      "priority": 10,
      "scope": {
        "apps": [],
        "appPrefixes": [],
        "excludeApps": [],
        "windowTypes": ["APPLICATION"]
      },
      "guard": {
        "requiredMarkers": ["跳过", "广告", "剩余", "倒计时", "秒后继续", "秒可关闭"],
        "markerMode": "ANY",
        "requireNonSystemWindow": true,
        "requireNonIme": true,
        "requireMasterSwitch": true,
        "forbiddenWhenNoMarker": ["评论", "选集", "倍速", "弹幕", "分享", "投屏"]
      },
      "selector": {
        "viewIds": [],
        "viewIdSuffixes": [],
        "textContains": ["跳过"],
        "descContains": ["跳过"],
        "maxTextLength": 10,
        "visibleToUser": true,
        "target": "MATCHED_NODE_OR_CLICKABLE_ANCESTOR"
      },
      "decision": { "adType": "OPEN_AD", "action": "CLICK_SKIP", "scene": "OPEN_AD" },
      "gate": { "matchTimeMs": 3000, "actionMaximum": 1 },
      "verify": {
        "expectGoneMarkers": ["跳过"],
        "checkDelayMs": 300,
        "maxChecks": 3,
        "onFailure": "DIAG_ONLY"
      },
      "recall": {
        "enabled": true,
        "mode": "SEQUENTIAL",
        "maxCandidates": 6,
        "maxAttempts": 6,
        "perCandidateMaxChecks": 3,
        "retryDelayMs": 300,
        "stopOnFirstConfirmed": true,
        "candidates": [
          {
            "kind": "VIEW_ID_EXACT",
            "priority": 100,
            "scene": "OPEN_AD",
            "viewIds": ["tv_skip", "btn_skip", "skip_btn", "iv_skip", "ad_skip"],
            "target": {
              "requireVisibleToUser": true,
              "maxWidthRatio": 0.25,
              "maxHeightRatio": 0.15,
              "allowedRegions": ["TOP_RIGHT", "TOP_LEFT"],
              "allowClickAdBody": false,
              "requireClickableOrAncestor": true,
              "maxAncestorDepth": 6
            }
          },
          {
            "kind": "VIEW_ID_SUFFIX",
            "priority": 90,
            "scene": "OPEN_AD",
            "suffixes": ["ms_skipView", "skipView", "skip_view", "skipBtn", "skip_btn", "tv_skip", "btn_skip", "ad_skip", "skip_container"],
            "target": {
              "requireVisibleToUser": true,
              "maxWidthRatio": 0.25,
              "maxHeightRatio": 0.15,
              "allowedRegions": ["TOP_RIGHT", "TOP_LEFT", "BOTTOM_RIGHT"],
              "allowClickAdBody": false,
              "requireClickableOrAncestor": true,
              "maxAncestorDepth": 6
            }
          },
          {
            "kind": "TEXT_ANCHOR",
            "priority": 80,
            "scene": "OPEN_AD",
            "words": ["跳过", "跳过广告", "Skip", "SKIP", "跳过此广告"],
            "maxTextLength": 10,
            "requireAdMarker": true,
            "target": {
              "requireVisibleToUser": true,
              "maxWidthRatio": 0.25,
              "maxHeightRatio": 0.15,
              "allowedRegions": ["TOP_RIGHT", "TOP_LEFT", "BOTTOM_RIGHT", "BOTTOM_LEFT"],
              "allowClickAdBody": false,
              "requireClickableOrAncestor": true,
              "maxAncestorDepth": 6
            }
          },
          {
            "kind": "CLOSE_TEXT",
            "priority": 70,
            "scene": "OPEN_AD",
            "words": ["×", "X", "关闭", "关闭广告", "SKIP"],
            "maxTextLength": 10,
            "requireAdMarker": true,
            "target": {
              "requireVisibleToUser": true,
              "maxWidthRatio": 0.15,
              "maxHeightRatio": 0.10,
              "allowedRegions": ["TOP_RIGHT", "TOP_LEFT"],
              "allowClickAdBody": false,
              "requireClickableOrAncestor": true,
              "maxAncestorDepth": 6
            }
          },
          {
            "kind": "SELF_DRAWN_SKIP",
            "priority": 50,
            "scene": "OPEN_AD",
            "viewIds": [],
            "suffixes": [],
            "words": [],
            "maxTextLength": 10,
            "requireAdMarker": false,
            "requireStructureChange": true,
            "target": {
              "requireVisibleToUser": true,
              "maxWidthRatio": 0.12,
              "maxHeightRatio": 0.10,
              "allowedRegions": ["TOP_RIGHT"],
              "allowClickAdBody": false,
              "requireClickableOrAncestor": false,
              "maxAncestorDepth": 6
            }
          }
        ]
      }
